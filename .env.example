# Optional local server port.
PORT=3000

# Optional: enables server-side AI bouquet image generation.
GEMINI_API_KEY=

# Optional model override. Defaults to gemini-2.5-flash-image.
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# Optional: enables Google Analytics 4 after the visitor grants analytics consent.
VITE_GA_MEASUREMENT_ID=
